generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tire {
  id            String         @id @default(cuid())
  name          String
  slug          String         @unique @default(cuid())
  brand         String
  season        String
  size          String
  width         Int?
  aspectRatio   Int?
  rimSize       Int?
  loadIndex     String?
  speedRating   String?
  dot           String?
  price         Float
  description   String?
  features      String
  stock         Int            @default(0)
  inStock       Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  condition     String         @default("new")
  barcode       String?        @unique
  efficiency    String?
  grip          String?
  noise         String?
  noiseDb       Int?
  appointments  Appointment[]
  orderItems    OrderItem[]
  stockRequests StockRequest[]
  images        TireImage[]
}

model TireImage {
  id        String   @id @default(cuid())
  url       String
  key       String
  order     Int      @default(0)
  tireId    String
  createdAt DateTime @default(now())
  tire      Tire     @relation(fields: [tireId], references: [id], onDelete: Cascade)
}

model Contact {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String?
  service      String?
  message      String
  status       String   @default("unread")
  replyMessage String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  price       Float?
  duration    String?
  icon        String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Order {
  id              String           @id @default(cuid())
  orderNumber     String           @unique
  status          String           @default("pending")
  email           String
  phone           String?
  shippingCarrier String?
  shippingMethod  String?
  shippingCost    Float            @default(0)
  trackingNumber  String?
  stripeSessionId String?          @unique
  stripePaymentId String?
  subtotal        Float
  total           Float
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  items           OrderItem[]
  shippingAddress ShippingAddress?
}

model OrderItem {
  id           String  @id @default(cuid())
  orderId      String
  tireId       String?
  quantity     Int
  price        Float
  withMounting Boolean @default(false)
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  tire         Tire?   @relation(fields: [tireId], references: [id])
}

model ShippingAddress {
  id         String @id @default(cuid())
  orderId    String @unique
  firstName  String
  lastName   String
  street     String
  city       String
  postalCode String
  country    String @default("BE")
  order      Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Feedback {
  id        String   @id @default(cuid())
  happiness Int
  feedback  String?
  createdAt DateTime @default(now())
}

model StockRequest {
  id        String   @id @default(cuid())
  tireId    String
  email     String
  name      String?
  phone     String?
  status    String   @default("pending")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tire      Tire     @relation(fields: [tireId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  locale          String        @default("nl")
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  coverImageKey   String?
  status          String        @default("draft")
  publishedAt     DateTime?
  metaTitle       String?
  metaDescription String?
  author          String?
  categoryId      String?
  readingTime     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lastViewedAt    DateTime?
  viewCount       Int           @default(0)
  images          BlogImage[]
  category        BlogCategory? @relation(fields: [categoryId], references: [id])

  @@index([locale, status])
  @@index([slug])
  @@index([publishedAt])
}

model BlogCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  posts       BlogPost[]
}

model BlogImage {
  id        String   @id @default(cuid())
  url       String
  key       String
  alt       String?
  order     Int      @default(0)
  postId    String
  createdAt DateTime @default(now())
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model AbandonedCheckout {
  id          String    @id @default(cuid())
  email       String
  firstName   String?
  lastName    String?
  phone       String?
  street      String?
  city        String?
  postalCode  String?
  country     String    @default("BE")
  cartItems   String
  subtotal    Float     @default(0)
  emailSent   Boolean   @default(false)
  emailSentAt DateTime?
  recovered   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([emailSent, createdAt])
}

model Appointment {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String
  phone        String
  tireId       String?
  tireName     String?
  date         DateTime
  notes        String?
  status       String   @default("pending")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  reminderSent Boolean  @default(false)
  tire         Tire?    @relation(fields: [tireId], references: [id])

  @@index([date])
  @@index([email])
}
